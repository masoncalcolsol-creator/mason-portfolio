# Direct private delivery for INSTANTIATION challenge receipts
# Configure real production values only in the deployment provider's secret store.
RESEND_API_KEY=
INSTANTIATION_REVIEW_EMAIL=review@example.com
# Use onboarding@resend.dev for account-owner testing, then replace with a verified sender.
INSTANTIATION_FROM_EMAIL=INSTANTIATION <onboarding@resend.dev>

# Optional durable intake webhook; email delivery remains the user-facing success gate.
INSTANTIATION_INTAKE_WEBHOOK_URL=
INSTANTIATION_INTAKE_WEBHOOK_TOKEN=
