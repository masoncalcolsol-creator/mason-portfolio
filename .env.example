# Shared private delivery provider
# Configure real production values only in the deployment provider's secret store.
RESEND_API_KEY=

# Direct private delivery for INSTANTIATION challenge receipts
INSTANTIATION_REVIEW_EMAIL=review@example.com
# Use onboarding@resend.dev for account-owner testing, then replace with a verified sender.
INSTANTIATION_FROM_EMAIL=INSTANTIATION <onboarding@resend.dev>

# Optional durable INSTANTIATION intake webhook; email delivery remains the user-facing success gate.
INSTANTIATION_INTAKE_WEBHOOK_URL=
INSTANTIATION_INTAKE_WEBHOOK_TOKEN=

# PRESSURE COOKER can inherit the INSTANTIATION review/from values above.
# Set dedicated values when the public pressure lab gets its own reviewed sender and inbox.
PRESSURE_COOKER_REVIEW_EMAIL=
PRESSURE_COOKER_FROM_EMAIL=PRESSURE COOKER <onboarding@resend.dev>

# Optional durable store / automation bridge for challenge and subscription records.
# Until configured and verified, the public page claims private email delivery only.
PRESSURE_COOKER_INTAKE_WEBHOOK_URL=
PRESSURE_COOKER_INTAKE_WEBHOOK_TOKEN=
