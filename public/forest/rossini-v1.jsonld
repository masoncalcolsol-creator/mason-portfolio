  "llf:origin": "BLOOD PAGODA song concept → Rossini-inspired gallop → childhood encyclopedia memory → factual reconciliation → Live Learning Forest.",
  "llf:claims": [
    {
      "@id": "llf:CLM-ROSSINI-001",
      "statement": "Guillaume Tell received its first performance at the Paris Opéra on August 3, 1829.",
      "truthState": "VERIFIED",
      "citation": "https://catalogue.bnf.fr/ark:/12148/cb13918026z"
    },
    {
      "@id": "llf:CLM-ROSSINI-002",
      "statement": "Guillaume Tell was Rossini's final opera, after which he retired from composing for the stage.",
      "truthState": "VERIFIED",
      "citation": "https://www.metopera.org/discover/education/educator-guides/la-cenerentola/the-operas-plot-and-creation/"
    },
    {
      "@id": "llf:CLM-ROSSINI-003",
      "statement": "In the opera, Tell is ordered to shoot an apple placed on the head of his young son, Jemmy.",
      "truthState": "VERIFIED",
      "citation": "https://archive.sfopera.com/guillaume-tell/1991-1992"
    },
    {
      "@id": "llf:CLM-ROSSINI-004",
      "statement": "The opera's story is based on Friedrich Schiller's Wilhelm Tell, published in 1804.",
      "truthState": "VERIFIED",
      "citation": [
        "https://catalogue.bnf.fr/ark:/12148/cb13918026z",
        "https://www.metopera.org/user-information/synopses-archive/guillaume-tell/"
      ]
    },
    {
      "@id": "llf:CLM-ROSSINI-005",
      "statement": "Library of Congress catalog records preserve the overture as four named sections: dawn, storm, calm, and finale.",
      "truthState": "VERIFIED",
      "citation": [
        "https://www.loc.gov/item/jukebox-245816/",
        "https://www.loc.gov/item/jukebox-119720/",
        "https://www.loc.gov/item/jukebox-119725/",
        "https://www.loc.gov/item/jukebox-119734/"
      ]
    },
    {
      "@id": "llf:CLM-ROSSINI-006",
      "statement": "The famous 1812 Overture is by Pyotr Ilyich Tchaikovsky, and Carnegie Hall's work authority dates it to 1880.",
      "truthState": "VERIFIED",
      "citation": [
        "https://data.carnegiehall.org/works/18188/about",
        "https://www.loc.gov/item/jukebox-422360/"
      ]
    }
  ],
