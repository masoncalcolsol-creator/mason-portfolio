      "citation": "https://en.tchaikovsky-research.net/pages/1812_Overture"
    },
    {
      "@id": "llf:CLM-1812-003",
      "statement": "It was commissioned in connection with the All-Russian Arts and Industrial Exhibition planned for Moscow.",
      "truthState": "VERIFIED",
